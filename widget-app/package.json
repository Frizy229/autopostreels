{
  "name": "reels-widget",
  "productName": "Reels Widget",
  "version": "3.4.0",
  "description": "Виджет автопостера рилсов: очередь, план дня и результаты",
  "main": "main.js",
  "author": "Alex",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node test/core.test.js",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.dayzerorules.reelswidget",
    "productName": "Reels Widget",
    "files": ["main.js", "preload.js", "lib/**", "renderer/**", "assets/**", "package.json"],
    "directories": { "output": "dist" },
    "win": { "target": "nsis", "icon": "assets/icon.png" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "artifactName": "ReelsWidget-Setup.exe",
      "shortcutName": "Reels Widget"
    }
  }
}
